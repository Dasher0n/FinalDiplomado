{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/reglas_agente.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "docs/*": "deny",
      "artefactos/*": "deny",
      "referencia/*": "deny",
      "opencode.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch": "allow",
      "make test*": "allow",
      "make lint*": "allow",
      "make format*": "allow",
      "make contracts*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "sudo *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git checkout main*": "deny",
      "rm -rf *": "deny",
      "docker system prune*": "deny",
      "docker volume rm*": "deny",
      "cat *.env*": "deny",
      "printenv*": "deny",
      "env": "deny"
    },
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask"
  }
}
